# ========= Project identity =========
# Human-readable project title
PROJECT_NAME="barrels-api"

# The stack name used in Traefik labels and Compose (keep short, lowercase, dashes/underscores)
# Override per environment (see env-specific sections below).
STACK_NAME=barrels-api

# ========= Environment selection =========
# One of: local | staging | production
# dev branch: local
# main branch: production (for local prod-like testing)
# master branch: staging or production (depending on workflow)
ENVIRONMENT=local

# ========= Domains and hosts =========
# The root domain used for routing. Examples:
# - local: localhost (or localhost.tiangolo.com if using local Traefik HTTPS)
# - staging: staging.api.barrels.gd
# - production: api.barrels.gd
DOMAIN=localhost

# Public client origin used in emails (optional). Leave empty for backend-only.
FRONTEND_HOST=

# ========= API and routing =========
# CORS origins accepted by the backend (comma-separated)
# Backend-only defaults allow direct API access.
BACKEND_CORS_ORIGINS="http://localhost:8000"

# ========= Security =========
# Generate a strong secret (e.g., `openssl rand -base64 32` or `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
SECRET_KEY=changethis

# Bootstrap superuser for first-time initialization
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Optional auth key for smoke reports (if you use smokeshow or similar tooling)
SMOKESHOW_AUTH_KEY=changethis

# ========= Email (Provider) =========
# Use Resend in staging/production (recommended). Set your API key here.
# If RESEND_API_KEY is set, the backend will send via Resend.
# If not set, the backend falls back to SMTP settings below (e.g., MailCatcher for local).
RESEND_API_KEY=changethis

# SMTP fallback (local dev with MailCatcher or real SMTP if needed)
# Leave empty locally or use mailcatcher (see docker-compose.override.yml)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Local deve override (mailcatcher) is done in docker-compose.override.yml.

# ========= Database (PostgreSQL) =========
# In Compose, db is the service name; change only if using an external DB host.
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Choose different DB name and credentials per environment for isolation.
# For local development:s
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Examples to use in staging/prod (documented only; set them in the env used by that env):
# POSTGRES_DB=app_staging
# POSTGRES_USER=barrels_staging
# POSTGRES_PASSWORD=strong-staging-password
# POSTGRES_DB=app_prod
# POSTGRES_USER=barrels_prod
# POSTGRES_PASSWORD=strong-production-password

# ========= Observability =========
# Keep empty if not used; must be either empty or a valid DSN URL to avoid validation errors.
SENTRY_DSN=

# ========= Container image names (registry targets) =========
# Use your registry of choice. GHCR example:
# DOCKER_IMAGE_BACKEND=ghcr.io/<your-org>/fast-back-backend
# Local defaults (no registry):
DOCKER_IMAGE_BACKEND=backend

# Optional tagging (CI may set TAG, e.g., git sha or semver)
# TAG=latest

# ========= Traefik (reverse proxy) =========
# For docker-compose.traefik.yml (production/staging Traefik):
# EMAIL is required by Let's Encrypt. USERNAME/HASHED_PASSWORD secure the dashboard.
# Generate bcrypt hash: `htpasswd -nbB admin 'yourpassword'` or use an online bcrypt generator.
EMAIL=
USERNAME=
HASHED_PASSWORD=

# ========= Environment-specific reference (documented) =========
# Use these as documented constants for workflows/scripts; STACK_NAME below helps ensure isolation.
DOMAIN_PRODUCTION=api.barrels.gd
DOMAIN_STAGING=staging.api.barrels.gd

STACK_NAME_PRODUCTION=barrels-api
STACK_NAME_STAGING=barrels-api-staging

# ========= Developer guidance =========
# Branch-to-env expectations (workflows may export COMPOSE_PROJECT_NAME from PROJECT_NAME at runtime):
# - dev:        ENVIRONMENT=local;    DOMAIN=localhost; STACK_NAME=barrels-api-dev;    PROJECT_NAME=barrels-api-dev
# - main:       ENVIRONMENT=production (for local prod-like tests); DOMAIN=localhost or localhost.tiangolo.com; STACK_NAME=barrels-api-main;   PROJECT_NAME=barrels-api-main
# - master:     staging workflow => ENVIRONMENT=staging;    DOMAIN=staging.api.barrels.gd; STACK_NAME=barrels-api-staging; PROJECT_NAME=barrels-api-staging
#               production workflow => ENVIRONMENT=production; DOMAIN=api.barrels.gd;           STACK_NAME=barrels-api;         PROJECT_NAME=barrels-api
#
# Important:
# - In workflows/VM shell, run: export COMPOSE_PROJECT_NAME="$PROJECT_NAME" before docker compose commands.
# - Keep SENTRY_DSN empty unless you have a real DSN.
# - Use unique DB names/credentials per environment.
# - For local HTTPS with Traefik override, set DOMAIN=localhost.tiangolo.com.