# ==================================
# Production Environment Variables
# ==================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================================
# Core Configuration
# ==================================
ENVIRONMENT=production

# Project Information
PROJECT_NAME=FastAPI Backend
STACK_NAME=fast-back

# Domain Configuration
DOMAIN=api.yourdomain.com
FRONTEND_HOST=https://yourdomain.com

# ==================================
# Security (CRITICAL - CHANGE THESE!)
# ==================================
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ==================================
# Database Configuration
# ==================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# First Superuser (Admin)
# ==================================
FIRST_SUPERUSER=admin@yourdomain.com
# Generate strong password: openssl rand -base64 32
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# Email Configuration
# ==================================
# Option 1: Resend API (Recommended for production)
RESEND_API_KEY=re_your_resend_api_key_here
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=Your App Name

# Option 2: SMTP (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Email Settings
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEST_USER=test@yourdomain.com

# ==================================
# CORS Configuration
# ==================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ==================================
# Monitoring & Error Tracking
# ==================================
# Sentry DSN (optional but recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================================
# OAuth/Social Login (Optional)
# ==================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ==================================
# Redis Configuration (if using caching)
# ==================================
# REDIS_URL=redis://redis:6379/0

# ==================================
# S3/Storage Configuration (if using file uploads)
# ==================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# ==================================
# Rate Limiting (if implemented)
# ==================================
# RATE_LIMIT_PER_MINUTE=60

# ==================================
# Feature Flags
# ==================================
# ENABLE_REGISTRATION=true
# ENABLE_EMAIL_VERIFICATION=true

# ==================================
# Docker-specific (for docker-compose.prod.yml)
# ==================================
# TAG=latest
# LETS_ENCRYPT_EMAIL=admin@yourdomain.com

