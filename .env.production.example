# ==================================
# Production Environment Variables
# ==================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================================
# Core Configuration
# ==================================
ENVIRONMENT=production

# Project Information
PROJECT_NAME=FastAPI Backend
STACK_NAME=fast-back

# Domain Configuration
DOMAIN=api.yourdomain.com
FRONTEND_HOST=https://yourdomain.com

# ==================================
# Security (CRITICAL - CHANGE THESE!)
# ==================================
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ==================================
# Database Configuration
# ==================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# First Superuser (Admin)
# ==================================
FIRST_SUPERUSER=admin@yourdomain.com
# Generate strong password: openssl rand -base64 32
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# Email Configuration
# ==================================
# Option 1: Resend API (Recommended for production)
RESEND_API_KEY=re_your_resend_api_key_here
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=Your App Name

# Option 2: SMTP (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Email Settings
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEST_USER=test@yourdomain.com

# ==================================
# CORS Configuration
# ==================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ==================================
# Monitoring & Error Tracking
# ==================================
# Sentry DSN (optional but recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================================
# OAuth/Social Login (Optional)
# ==================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ==================================
# Redis Configuration (if using caching)
# ==================================
# REDIS_URL=redis://redis:6379/0

# ==================================
# S3/Storage Configuration (if using file uploads)
# ==================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# ==================================
# Rate Limiting (if implemented)
# ==================================
# RATE_LIMIT_PER_MINUTE=60

# ==================================
# Feature Flags
# ==================================
# ENABLE_REGISTRATION=true
# ENABLE_EMAIL_VERIFICATION=true

# ==================================
# Docker-specific (for docker-compose.prod.yml)
# ==================================
# TAG=latest
# LETS_ENCRYPT_EMAIL=admin@yourdomain.com


# Production Environment Configuration Template
# Copy this file and fill in actual values, especially secrets
# Store the actual file at: /home/github/.config/eugine-api/production.env on your VM

# Environment Configuration
ENVIRONMENT=production
DOMAIN=barrels.gd
STACK_NAME=barrels-api
PROJECT_NAME=Barrels API

# Docker Image Configuration
REGISTRY=ghcr.io
IMAGE_NAME=barrelsgd/eugine-api
TAG=latest

# Security & Authentication
SECRET_KEY=your-generated-secret-key-here-min-32-chars
FIRST_SUPERUSER=admin@barrels.gd
FIRST_SUPERUSER_PASSWORD=your-generated-password-here-min-12-chars

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-generated-db-password-here-min-16-chars

# API Configuration
API_V1_STR=/api/v1
FRONTEND_HOST=https://barrels.gd
BACKEND_CORS_ORIGINS=["https://barrels.gd","https://www.barrels.gd","https://api.barrels.gd"]

# Email Configuration (Optional)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@barrels.gd
EMAILS_FROM_NAME=Barrels API

# Monitoring & Error Tracking (Optional)
SENTRY_DSN=
