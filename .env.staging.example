# ==================================
# Staging Environment Variables
# ==================================
# Copy this file to .env.staging and fill in your actual values
# This file is for staging environment deployment

# ==================================
# Core Configuration
# ==================================
ENVIRONMENT=staging

# Project Information
PROJECT_NAME=FastAPI Backend (Staging)
STACK_NAME=fast-back-staging

# Domain Configuration
DOMAIN=staging.api.barrels.gd
FRONTEND_HOST=https://staging.barrels.gd

# ==================================
# Security (CRITICAL - CHANGE THESE!)
# ==================================
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ==================================
# Database Configuration
# ==================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app_staging
POSTGRES_USER=app
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# First Superuser (Admin)
# ==================================
FIRST_SUPERUSER=admin@staging.barrels.gd
# Generate strong password: openssl rand -base64 32
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# ==================================
# Email Configuration
# ==================================
# Option 1: Resend API (Recommended for staging)
RESEND_API_KEY=re_your_resend_api_key_here
EMAILS_FROM_EMAIL=noreply@staging.barrels.gd
EMAILS_FROM_NAME=FastAPI App (Staging)

# Option 2: SMTP (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_SSL=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Email Settings
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEST_USER=test@staging.barrels.gd

# ==================================
# CORS Configuration
# ==================================
# Staging-specific origins
BACKEND_CORS_ORIGINS=["https://staging.barrels.gd","https://www.staging.barrels.gd"]

# ==================================
# Monitoring & Error Tracking
# ==================================
# Sentry DSN for staging (optional but recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/staging-project-id

# ==================================
# Feature Flags
# ==================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true

# ==================================
# Development Tools
# ==================================
# Disable debug mode for staging
DEBUG=false

# ==================================
# OAuth/Social Login (Optional)
# ==================================
# GOOGLE_CLIENT_ID=your-google-client-id-staging
# GOOGLE_CLIENT_SECRET=your-google-client-secret-staging
# GITHUB_CLIENT_ID=your-github-client-id-staging
# GITHUB_CLIENT_SECRET=your-github-client-secret-staging

# ==================================
# Redis Configuration (if using caching)
# ==================================
# REDIS_URL=redis://redis:6379/0

# ==================================
# Storage Configuration (if using file uploads)
# ==================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-staging-bucket-name

# ==================================
# Rate Limiting (if implemented)
# ==================================
# RATE_LIMIT_PER_MINUTE=100

# ==================================
# Docker-specific (for docker-compose.staging.yml)
# ==================================
# TAG=staging
# LETS_ENCRYPT_EMAIL=admin@barrels.gd
