# ==================================
# Development Environment Variables
# ==================================
# Copy this file to .env and update values for local development
# Safe defaults are provided for testing and CI

# ==================================
# Core Configuration
# ==================================
ENVIRONMENT=local

# Project Information
PROJECT_NAME=FastAPI Backend
STACK_NAME=fast-back

# Domain Configuration
DOMAIN=localhost
FRONTEND_HOST=http://localhost:3000

# ==================================
# Security
# ==================================
# Default for development (change for production!)
SECRET_KEY=changethis

# ==================================
# Database Configuration
# ==================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
# Default for development (change for production!)
POSTGRES_PASSWORD=changethis

# ==================================
# First Superuser (Admin)
# ==================================
FIRST_SUPERUSER=admin@example.com
# Default for development (change for production!)
FIRST_SUPERUSER_PASSWORD=changethis

# ==================================
# Email Configuration (Development)
# ==================================
# Using MailCatcher for local development
SMTP_HOST=mailcatcher
SMTP_PORT=1025
SMTP_TLS=false
SMTP_SSL=false
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=FastAPI App

# Email Settings
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEST_USER=test@example.com

# Production email (Resend API) - leave empty for development
RESEND_API_KEY=

# ==================================
# CORS Configuration
# ==================================
# Allow all origins in development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ==================================
# Monitoring & Error Tracking
# ==================================
# Leave empty for development
SENTRY_DSN=

# ==================================
# OAuth/Social Login (Optional)
# ==================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ==================================
# Redis Configuration (if using caching)
# ==================================
# REDIS_URL=redis://localhost:6379/0

# ==================================
# Feature Flags
# ==================================
# ENABLE_REGISTRATION=true
# ENABLE_EMAIL_VERIFICATION=false

